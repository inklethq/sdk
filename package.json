{
  "name": "@inklethq/sdk",
  "version": "0.3.0",
  "description": "Official JavaScript and TypeScript SDK for Inklet.",
  "keywords": [
    "inklet",
    "e-ink",
    "e-paper",
    "display",
    "sdk",
    "typescript"
  ],
  "author": "inklet LLC",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inklethq/sdk.git"
  },
  "homepage": "https://github.com/inklethq/sdk#readme",
  "bugs": {
    "url": "https://github.com/inklethq/sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --project test/tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm run typecheck && npm run test",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
